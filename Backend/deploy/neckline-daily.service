# 交易日 16:05 盘后增量：拉取全市场 daily/basic/adj/moneyflow，刷新停复牌与申万分类，
# 写入 Parquet，并重算尾部涨跌停衍生窗口。

[Unit]
Description=Neckline EOD market data update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=neckline
Group=neckline
WorkingDirectory=/opt/neckline
EnvironmentFile=/opt/neckline/.env
ExecStart=/opt/neckline/.venv/bin/python scripts/daily_update.py
MemoryMax=900M
