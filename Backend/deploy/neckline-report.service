# 晚间链第 3 段：装配报告、落库与 APNs。零 LLM、零全市场批算。
[Unit]
Description=Neckline evening chain seg3: report + persistence + APNs
Documentation=file:///opt/neckline/PROJECT_PLAN.md
After=network-online.target neckline-strategy.service
Wants=network-online.target

[Service]
Type=oneshot
User=neckline
Group=neckline
WorkingDirectory=/opt/neckline
EnvironmentFile=/opt/neckline/.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/neckline/.venv/bin/python scripts/evening.py --scheduled --segments report --notify --k9-params-env K9_PARAMS_PATH
TimeoutStartSec=2400
# B5 宁波云 20 只清单报告装配实测约 49 MiB；512M 覆盖通知与生产波动余量。
MemoryMax=512M
