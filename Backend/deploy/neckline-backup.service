[Unit]
Description=Optional Neckline encrypted S3 backup with isolated restore verification
After=network-online.target
Wants=network-online.target

[Service]
# 可选能力：生产默认不启用对应 timer。只有 S3、公开密钥和隔离恢复验证器均已配置，
# 且人工恢复演练通过后，才可显式 systemctl enable --now neckline-backup.timer。
Type=oneshot
User=neckline
Group=neckline
WorkingDirectory=/opt/neckline
EnvironmentFile=/opt/neckline/.env
ExecStart=/opt/neckline/.venv/bin/python scripts/backup_snapshot.py
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
