# Neckline API service. This process serves FastAPI only. Morning collection,
# report generation and the deadline check are separate timer units.
#
# Keep :8002 bound for the existing reverse-proxy bridge. Firewall policy
# restricts direct access to that bridge; the binding alone is not the boundary.
[Unit]
Description=Neckline API (FastAPI :8002): V4 morning report and read page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neckline
Group=neckline
WorkingDirectory=/opt/neckline
EnvironmentFile=/opt/neckline/.env
EnvironmentFile=-/etc/neckline/v4.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/neckline/.venv/bin/uvicorn neckline.api.app:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=5
# API process memory guard. Collection and model calls run in the timer units.
MemoryHigh=420M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
