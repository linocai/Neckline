# Neckline V3 API service.  K10 scans, analysis, market collection and
# notifications are separate durable worker/timer units; this process serves
# FastAPI only.
#
# Keep :8002 bound for the existing reverse-proxy bridge.  Firewall policy
# restricts direct access to that bridge; the binding alone is not the boundary.
[Unit]
Description=Neckline V3 K10 API (FastAPI :8002)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neckline
Group=neckline
WorkingDirectory=/opt/neckline
EnvironmentFile=/opt/neckline/.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/neckline/.venv/bin/uvicorn neckline.api.app:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=5
# Preserve the established API memory guardrails.  Worker/model workload belongs
# to neckline-k10-worker.service, not this process.
MemoryHigh=420M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
