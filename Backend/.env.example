# Neckline 后端配置示例。复制为 .env 后填值(.env 已在 .gitignore,绝不提交)。
#   cp .env.example .env
#
# 缺少资讯凭据只影响对应来源采集/补证，报告仍可使用已保存资料；缺少 APNs 凭据时不发送推送。
# LLM Provider、默认模型、任务路由和 Tavily key 均在 App 设置屏写入数据库。

# —— 数据源(plan §3.2)——
TUSHARE_TOKEN=
JIN10_MCP_TOKEN=

# —— API 鉴权(plan 4A.1;单用户共享密钥,Bearer 比对,len>=16,startup fail-fast)——
# 生成:python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# —— APNs(plan 4B.5;复用 LinoN 账号级 .p8,topic 换新 Bundle ID)——
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=top.linotsai.neckline
APNS_KEY_PATH=
APNS_USE_SANDBOX=true

# —— SQLite 库路径(可选;默认 data/neckline.db。冒烟/隔离用临时库)——
# DB_PATH=/opt/neckline/data/neckline.db
# PARQUET_DIR=/opt/neckline/data/parquet

# —— K10 service runtime (the service units require all values; no defaults) ——
# K10_PYTHON=/opt/neckline/.venv/bin/python
# B93全新起点：下列K10路径必须与DB_PATH/PARQUET_DIR指向同一新空存储；不可遗留旧库路径。
# K10_DB_PATH=/opt/neckline/data/neckline.db
# K10_PARQUET_DIR=/opt/neckline/data/parquet
# K10_WORKER_ID=neckline-k10-worker-1
# Current immutable K10 config binding.  Production keeps these two variables
# in /etc/neckline/k10.env, loaded by both API and timer units.  Set both via
# the explicit configure flow; API never falls back to a scan or latest record.
# K10_CONFIG_ID=
# K10_CONFIG_REVISION=
# Separate immutable execution profile used by timer enqueue and frozen-scan
# recovery.  It changes throughput/retry mechanics, never the K10 strategy pack.
# K10_EXECUTION_CONFIG_ID=
# K10_EXECUTION_CONFIG_REVISION=
# B92 independent collection binding; use configure-collection's returned revision.
# Registration starts closed. It does not resume reports or enable timers.
# K10_COLLECTION_CONFIG_ID=
# K10_COLLECTION_CONFIG_REVISION=
# K10 strategy/runtime packs are tracked at neckline/config/k10-v2.json and
# k10-execution-v4.json; model credentials remain in settings, never here.
