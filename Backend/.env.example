# Neckline 后端配置示例。复制为 .env 后填值（.env 已在 .gitignore，绝不提交）。
#   cp .env.example .env
#
# 生产上鉴权、推送和资讯凭据在 /opt/neckline/.env；晨报库、模型与只读网页在
# /etc/neckline/v4.env。读取时忽略未知变量。
# 缺少资讯凭据只影响对应来源；缺少 APNs 凭据时不发送推送；缺少模型凭据时不出新晨报。

# —— 资讯来源 ——
TUSHARE_TOKEN=
JIN10_MCP_TOKEN=
# 麦蕊证书。同一证书 60 秒内最多两个来源 IP，不要在本地和 KX 同时打真接口。
MAIRUI_LICENCE=

# —— API 鉴权（Bearer，len>=16，缺失则拒绝启动）——
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# —— APNs ——
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=top.linotsai.neckline
APNS_KEY_PATH=
APNS_USE_SANDBOX=true

# —— V4 晨报（生产放在 /etc/neckline/v4.env，root:neckline 0640）——
# NECKLINE_V4_DB_PATH=/opt/neckline/data/v4.db
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=   # 仅离线筛选脚本；定时出报的模型名在 screening-v1.json
# NECKLINE_READ_KEY=   # 只读网页访问码，至少 24 位，只交给用户本人

# —— 只读 MCP（缺任何一项时 API 照常启动，/mcp 与 OAuth 返回未就绪）——
# 公开地址，不要带路径。生产是 https://nk.linotsai.top
NECKLINE_PUBLIC_BASE=
# 连接口令只存 salt 和 scrypt 哈希（n=16384, r=8, p=1, dklen=32），不要写明文。
# salt 至少 16 字节的十六进制；hash 是 32 字节的十六进制。
NECKLINE_MCP_PASSWORD_SALT=
NECKLINE_MCP_PASSWORD_HASH=
# OAuth 状态库，必须是绝对路径，不要指向 v4.db。生产建议 /opt/neckline/data/mcp-auth.db
NECKLINE_MCP_AUTH_DB=
