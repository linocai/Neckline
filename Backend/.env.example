# Neckline 后端配置示例。复制为 .env 后填值(.env 已在 .gitignore,绝不提交)。
#   cp .env.example .env
#
# 缺少 TUSHARE_TOKEN 时数据任务不会运行；缺少 APNs 凭据时不发送推送。
# LLM Provider、默认模型、任务路由和 Tavily key 均在 App 设置屏写入数据库。

# —— 数据源(plan §3.2)——
TUSHARE_TOKEN=

# —— API 鉴权(plan 4A.1;单用户共享密钥,Bearer 比对,len>=16,startup fail-fast)——
# 生成:python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# —— APNs(plan 4B.5;复用 LinoN 账号级 .p8,topic 换新 Bundle ID)——
APNS_KEY_ID=Q963AP3VY8
APNS_TEAM_ID=HX73DFL88G
APNS_BUNDLE_ID=top.linotsai.neckline
APNS_KEY_PATH=/opt/neckline/AuthKey_Q963AP3VY8.p8
APNS_USE_SANDBOX=true

# —— SQLite 库路径(可选;默认 data/neckline.db。冒烟/隔离用临时库)——
# DB_PATH=/opt/neckline/data/neckline.db

# —— 异机加密备份（必须全部显式配置，否则 backup_snapshot.py 失败退出）——
# 服务端只持有接收方公钥与对象存储上传凭据；解密私钥只能保存在用户 Mac。
# BACKUP_DB_PATH=/opt/neckline/data/neckline.db
# BACKUP_FACT_PACK_ROOT=/opt/neckline/data/parquet/fact_pack
# BACKUP_RECIPIENT_PUBLIC_KEY_PATH=/opt/neckline/backup-recipient-public.pem
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=neckline-production
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_ENABLE_RETENTION=1
# 必须是可执行的隔离恢复验证器；用 {manifest_key} 接收本次 manifest 的对象键。
# 它不得把解密私钥放在服务端。
# BACKUP_RESTORE_VERIFY_COMMAND=
