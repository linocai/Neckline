# Neckline 16:00 盘后报告定时(plan 4B.4)。A 股 16:00 后收盘数据稳定(§2.3)。
# 交易日门控在 report.py 内(is_trading_day),故 timer 打 Mon-Fri,节假日 report.py 自退。
[Unit]
Description=Run Neckline EOD report at 16:00 on weekdays

# ⚠ 排在 daily(16:05)之后:report 需要当日 EOD 数据已由 daily_update 落进 Parquet
# (plan 原文「report 16:00 / daily 16:30」把依赖顺序写反了——report 依赖 daily 先拉数;
# 方案 A 下改为 daily 16:05 → report 16:35。方案 B 下数据在 Mac 落好 rsync 上云,report 可提前)。
[Timer]
OnCalendar=Mon-Fri 16:35 Asia/Shanghai
Persistent=false

[Install]
WantedBy=timers.target
