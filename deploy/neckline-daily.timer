# Neckline 盘后数据增量定时(plan 4B.4,**仅方案 A 启用**)。16:30 Asia/Shanghai。
# 交易日门控在 daily_update.py 内(非交易日自退)。
[Unit]
Description=Run Neckline daily data update at 16:30 on weekdays (Scheme A only)

# 16:05:A 股 15:00 收盘、TuShare 核心 EOD(daily/basic/adj)~15:35 后稳定,给缓冲;
# 排在 report(16:35)之前——report 依赖当日数据先落 Parquet(见 neckline-report.timer 说明)。
[Timer]
OnCalendar=Mon-Fri 16:05 Asia/Shanghai
Persistent=false

[Install]
WantedBy=timers.target
